rm test.vdi

# qemu also can use vdi files. copy ubuntu 20.04 vdi here.
# from https://www.baeldung.com/linux/qemu-from-terminal, run
singularity exec --no-home --bind $HOME:$HOME:rw \
--bind $SYS_SCRATCH/users/$USER:$SYS_SCRATCH/users/$USER:rw qemu.sif qemu-system-x86_64 \
-m 4G                                                          \
-smp 2                                                         \
-hda ubuntu_2004_geomx.vdi                                     \
-netdev user,id=net0,net=192.168.0.0/24,dhcpstart=192.168.0.9  \
-device virtio-net-pci,netdev=net0 & # gets a vnc server running on 127.0.0.1

# add in forwarding to a ssh port on the device.
singularity exec --no-home --bind $HOME:$HOME:rw \
--bind $SYS_SCRATCH/users/$USER:$SYS_SCRATCH/users/$USER:rw qemu.sif qemu-system-x86_64 \
-m 4G                                                          \
-smp 2                                                         \
-hda ubuntu_2004_geomx.vdi                                     \
-netdev user,id=net0,net=192.168.0.0/24,dhcpstart=192.168.0.9,hostfwd=tcp::44788-:22  \
-device virtio-net-pci,netdev=net0 & # gets a vnc server running on 127.0.0.1 but no response to ssh geomx@127.0.0.1 -p 44788



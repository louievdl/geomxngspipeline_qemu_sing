### contents of pipeline_script.sh:

#!/bin/bash

echo 'hello from inside pipeline_script.sh' > /mnt/shared/out/hello.txt

# wait till geomx pipeline service is listening on port 5000
tmp=$(netstat -tuln | egrep "^tcp..*0.0.0.0:5000" | wc -l)
while [ "$tmp" == 0 ] ; do
  echo 'no listening on port 5000, waiting 2s' >> /mnt/shared/out/hello.txt
  sleep 2
  tmp=$(netstat -tuln | egrep "^tcp..*0.0.0.0:5000" | wc -l)
done
netstat -tuln >> /mnt/shared/out/hello.txt

# needed: a 'fastq' dir, an 'out' dir and an 'in' dir with a file called project.ini
mkdir -p /mnt/shared/out
if [ -f /mnt/shared/in/project.ini ] ; then
  geomxngspipeline --in=/mnt/shared/fastq --out=/mnt/shared/out --ini=/mnt/shared/in/project.ini
else
  echo "ERROR: missing project.ini file" > /mnt/shared/out/error.txt
fi

